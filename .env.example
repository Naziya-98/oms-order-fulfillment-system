# Copy this to .env and fill in real values locally. .env itself is gitignored.

# JWT CONFIG
JWT_SECRET=replace-with-a-real-secret
JWT_ISSUER=ikea-client

# API KEYS
CUSTOMER_API_KEY=replace-with-a-real-key
WAREHOUSE_API_KEY=replace-with-a-real-key

# DB
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-real-password
